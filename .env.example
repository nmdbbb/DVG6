# Copy thành .env rồi đổi mật khẩu. File .env KHÔNG BAO GIỜ commit.
# Mọi biến đều có giá trị mặc định trong docker-compose.yml, nên thiếu .env vẫn chạy được ở máy local.

# Tài khoản quản trị Postgres — chỉ dùng cho migration và reset
POSTGRES_USER=qtdl
POSTGRES_PASSWORD=change_me
POSTGRES_DB=qtdl
# localhost khi chạy từ máy host (notebook, psql); trong container được ghi đè thành "db"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Role nghiệp vụ (db/roles.sql) — ingestion/transform/quality dùng etl_writer, API dùng api_reader
ETL_WRITER_PASSWORD=change_me
API_READER_PASSWORD=change_me
ANALYST_PASSWORD=change_me

# Đường lấy dữ liệu: live (nguồn thật, mặc định) | mock (mock_server phát lại data/raw)
SOURCE_MODE=live
MOCK_PORT=8001
MOCK_LATENCY_MIN_MS=200
MOCK_LATENCY_MAX_MS=500
MOCK_RATE_LIMIT_PER_MIN=60

# Nơi giữ file nguồn tải tay (make landing-fetch / landing-upload). Mặc định là repo này.
LANDING_RELEASE_REPO=nmdbbb/DVG6
LANDING_RELEASE_TAG=landing

# Kho Postgres dùng chung (Neon/Supabase) — chỉ `make publish` dùng tới.
# Để trống nghĩa là chưa có kho chung; mọi lệnh khác vẫn chạy bình thường trên warehouse local.
SHARED_DATABASE_URL=

# API đọc kho chung thay vì local khi biến này có giá trị (dùng lúc deploy dashboard).
API_DATABASE_URL=

API_PORT=8000
WEB_PORT=5173
# Frontend gọi API qua proxy của Vite (/api -> service api), nên không cần CORS
VITE_API_BASE_URL=/api
