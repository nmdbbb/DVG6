# Copy thành .env rồi đổi mật khẩu. File .env KHÔNG BAO GIỜ commit.
# Mọi biến đều có giá trị mặc định trong docker-compose.yml, nên thiếu .env vẫn chạy được ở máy local.

# Tài khoản quản trị Postgres — chỉ dùng cho migration và reset
POSTGRES_USER=qtdl
POSTGRES_PASSWORD=change_me
POSTGRES_DB=qtdl
# localhost khi chạy từ máy host (notebook, psql); trong container được ghi đè thành "db"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Role nghiệp vụ (db/roles.sql) — ingestion/transform/quality dùng etl_writer, API dùng api_reader
ETL_WRITER_PASSWORD=change_me
API_READER_PASSWORD=change_me
ANALYST_PASSWORD=change_me

API_PORT=8000
WEB_PORT=5173
# Frontend gọi API qua proxy của Vite (/api -> service api), nên không cần CORS
VITE_API_BASE_URL=/api
